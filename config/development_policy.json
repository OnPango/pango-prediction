{
  "policy_version": "development-1",
  "frequency": "WEEKLY",
  "horizon": 4,
  "params_version": "f5f416da285217b5",
  "rules": [
    {
      "when": {
        "inactive": true
      },
      "reason": "Inactive series are not forecast by the development policy."
    },
    {
      "when": {
        "evaluable": false
      },
      "reason": "The series has too little observable history for an individual forecast."
    },
    {
      "when": {
        "demand_class": "SMOOTH"
      },
      "model": "naive"
    },
    {
      "when": {
        "demand_class": "ERRATIC"
      },
      "model": "moving_average",
      "params": {
        "window": 4
      }
    },
    {
      "when": {
        "demand_class": "INTERMITTENT"
      },
      "model": "zero"
    },
    {
      "when": {
        "demand_class": "LUMPY"
      },
      "model": "zero"
    }
  ],
  "default": {
    "model": "naive"
  }
}
