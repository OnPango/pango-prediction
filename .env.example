# PANGO Prediction — environment template
#
# Copy to .env and fill in real values. Never commit .env: it is in .gitignore.

# Shared credential Pango Core presents on every forecast request.
# Required: the service refuses to start without it.
# Must differ per environment, and must NOT be an end-user JWT.
PANGO_PREDICTION_SERVICE_TOKEN=change-me

# Largest batch the service accepts in one request (contract v1 §19).
# Optional, defaults to 500. Pango Core splits larger jobs into several calls.
PANGO_PREDICTION_MAX_SERIES_PER_REQUEST=500
